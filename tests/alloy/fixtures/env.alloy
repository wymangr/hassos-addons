// Override config that reads add-on supplied environment variables via sys.env().
logging {
	level  = "info"
	format = "logfmt"
}

prometheus.remote_write "default" {
	endpoint {
		url = string.format("https://%s.example.com/api/v1/write", sys.env("ALLOY_ENV"))

		basic_auth {
			username = sys.env("ALLOY_USER")
			password = sys.env("ALLOY_TOKEN")
		}
	}
}
